*.kdev4
*swp
*.idea
.vscode/
compile_commands.json
engine/.cache/

# Vim
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist
*~

# Other
.nfs*
*.tab

# evals reference outputs (override blanket *.tab rule above)
!evals/fixtures/*.tab
!evals/manual/*.tab
!engine/examples/*.tab
!evals/reference/tab
!evals/reference/fonts/**
evals/runs/
evals/dev/

# Private documentation
docs-private/
*.private.md
*-PRIVATE.md

# Dependencies (no trailing slash: a worktree's symlinked node_modules is a file, not a dir)
node_modules
bun.lockb

# Build output
dist/
build/
artifacts/
dist-releases/

# TypeScript
*.tsbuildinfo

# secrets and local config
.env
.env.*
!.env.example
!.env.*.example
.envrc
*.pem
*.key

# editor / OS
.DS_Store
.idea/

# AI agents - commit the team's agent files, keep personal config local
/.claude/*
!/.claude/CLAUDE.md
!/.claude/rules/
!/.claude/settings.json
!/.claude/agents/
!/.claude/commands/
!/.claude/hooks/
!/.claude/skills/
!/.claude/local/
/.claude/local/*
!/.claude/local/.gitkeep
CLAUDE.local.md

# Electrobun 2.x: Hutch devkit projection, and build temp a failed hook leaves behind
.hutch/
